# ==============================================================================
# IRIS — Backend Environment Configuration Template
# ==============================================================================

# --- 1. App Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Asia/Kolkata

# --- 2. Security ---
SECRET_KEY=change-me-in-production

# --- 3. Database ---
# Local dev: sqlite:///./iris.db | Production Docker: sqlite:////app/data/iris.db
DATABASE_URL=sqlite:///./iris.db

# --- 4. AI Model (any provider, any model; no code changes needed) ---
# IRIS is a harness: it adapts to whatever model you point it at (native tool
# calling vs. JSON prompting, reasoning output, JSON modes, context size).
#
# AI_PROVIDER presets (all OpenAI-compatible unless noted):
#   nvidia | openai | openrouter | groq | together | deepseek | mistral |
#   fireworks | anthropic | ollama | lmstudio | vllm | openai_compatible |
#   gemini (native SDK) | mock
AI_PROVIDER=nvidia
AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_API_KEY=
# Only needed for vllm / openai_compatible, or to override a preset's URL:
# AI_BASE_URL=http://localhost:8000/v1
# AI_TIMEOUT_SECONDS=60
#
# Examples: switching models is only ever these lines.
#   AI_PROVIDER=openai      AI_MODEL=gpt-4.1-mini
#   AI_PROVIDER=openrouter  AI_MODEL=anthropic/claude-sonnet-4.5
#   AI_PROVIDER=groq        AI_MODEL=llama-3.3-70b-versatile
#   AI_PROVIDER=ollama      AI_MODEL=qwen3:8b            (no key needed)
#
# --- Optional harness tuning ---
# AI_AGENT_MAX_STEPS=6          # model calls per chat turn (tool-use iterations)
# AI_MAX_RETRIES=2              # retries on 429/5xx transient errors
# AI_STRUCTURED_RETRIES=1       # attempts the model gets to repair invalid JSON
# AI_TEMPERATURE=0.3
# AI_MAX_TOKENS=4096
# Override auto-detected model capabilities (JSON). Keys: native_tools,
# json_mode (json_schema|json_object|none), reasoning, system_role,
# supports_temperature, max_tokens_param, context_window, max_output_tokens
# AI_CAPABILITIES={"native_tools": true, "context_window": 131072}
# Extra fields sent with every request, e.g. reasoning controls:
# AI_EXTRA_BODY={"reasoning_effort": "high"}
# AI_EXTRA_HEADERS={"HTTP-Referer": "https://iris.example.com"}

# --- 5. Legacy vendor settings (still honoured when AI_* above are unset) ---
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- 7. CORS ---
CORS_ORIGINS=[]

# --- Voice conversations (speech-to-text + text-to-speech) ---
# gemini (uses GEMINI_API_KEY) | openai_compatible (Groq, OpenAI, ... via AI_VOICE_*) | none
# AI_STT_PROVIDER=gemini
# AI_STT_MODEL=gemini-3.5-transcribe
# AI_TTS_PROVIDER=gemini
# AI_TTS_MODEL=gemini-3.8-flash-lite-tts
# AI_TTS_VOICE=Kore
# AI_VOICE_BASE_URL=https://api.groq.com/openai/v1
# AI_VOICE_API_KEY=
