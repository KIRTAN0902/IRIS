# ==============================================================================
# IRIS — Backend Environment Configuration Template
# ==============================================================================

# --- 1. App Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Asia/Kolkata

# --- 2. Security ---
SECRET_KEY=change-me-in-production

# --- 3. Database ---
# Local dev: sqlite:///./iris.db | Production Docker: sqlite:////app/data/iris.db
DATABASE_URL=sqlite:///./iris.db

# --- 4. AI Provider Selection ---
# Options: "omniroute" | "gemini" | "mock"
AI_PROVIDER=omniroute

# --- 5. OmniRoute Gateway ---
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto/best-fast
OMNIROUTE_TIMEOUT_SECONDS=45.0

# --- 6. Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45.0

# --- 7. CORS ---
CORS_ORIGINS=[]
