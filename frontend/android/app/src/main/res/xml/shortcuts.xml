<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="ambient_voice"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_voice_short"
        android:shortcutLongLabel="@string/shortcut_voice_long">
        <intent
            android:action="com.kirtan.iris.ACTION_AMBIENT_VOICE"
            android:targetPackage="com.kirtan.iris"
            android:targetClass="com.kirtan.iris.AssistantActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:shortcutId="ambient_screen"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_screen_short"
        android:shortcutLongLabel="@string/shortcut_screen_long">
        <intent
            android:action="com.kirtan.iris.ACTION_AMBIENT_SCREEN"
            android:targetPackage="com.kirtan.iris"
            android:targetClass="com.kirtan.iris.AssistantActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
