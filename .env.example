# ==============================================================================
# IRIS — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure for your environment.
# In Coolify, enter these in the "Environment Variables" / "Secrets" section.
# ==============================================================================

# --- 1. App Environment (Required) ---
ENVIRONMENT=production
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Asia/Kolkata

# --- 2. Security (Secret - Change in Production!) ---
SECRET_KEY=generate-a-strong-random-secret-key-here-minimum-32-characters

# --- 3. Database (Supabase PostgreSQL / SQLite) ---
# Production / Staging (Supabase PostgreSQL via Session Pooler - Recommended):
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Direct Supabase Connection:
# DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Local Development (SQLite):
DATABASE_URL=sqlite:///./iris.db

# --- 4. AI Provider Selection ---
# Options: "omniroute" | "gemini" | "mock"
AI_PROVIDER=omniroute

# --- 5. OmniRoute Gateway (OpenAI-compatible) ---
# Scenario A (External OmniRoute): OMNIROUTE_BASE_URL=https://omniroute.yourdomain.com/v1
# Scenario B (Coolify Internal Service): OMNIROUTE_BASE_URL=http://omniroute:20128/v1
# Scenario C (Local Development): OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your-omniroute-api-key-here
OMNIROUTE_MODEL=auto/best-fast
OMNIROUTE_TIMEOUT_SECONDS=45.0

# --- 6. Google Gemini (Alternative / Fallback Provider) ---
GEMINI_API_KEY=your-gemini-api-key-if-using-gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45.0

# --- 7. Optional Cross-Origin CORS ---
# In single-domain deployment (https://iris.example.com), leave empty.
# If hosting frontend on a separate domain (hybrid):
# CORS_ORIGINS=["https://iris.example.com"]
CORS_ORIGINS=[]
